# ===== 服务配置 =====
PORT=3000
# 对外可访问的地址（OAuth 回调 / Webhook 都要用它）
BASE_URL=http://localhost:3000

# ===== GitHub App 配置（在 GitHub App 设置页获取）=====
GITHUB_APP_ID=
# 私钥二选一：填文件路径（推荐）或直接填 PEM 内容
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=

# OAuth 客户端（GitHub App 设置页 → Client ID / Client secret）
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Webhook 密钥（GitHub App 设置页 → Webhook secret）
GITHUB_APP_WEBHOOK_SECRET=

# 会话加密种子（生产环境请使用随机长字符串，例如 openssl rand -hex 32）
SESSION_SECRET=

# OAuth 申请的权限范围（逗号分隔）
SCOPES=repo,workflow,notifications,read:org,gist

# 机器人自动回复：收到新 Issue / 新 PR 时自动发欢迎评论
BOT_WELCOME=true
